      "id": "switch-method",
      "name": "Switch Method",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 2,
      "position": [1000, 150]
    },
    {
      "parameters": {
        "jsCode": "// PAIR ACTION - QR Code Method\n// Generate QR code for WhatsApp pairing\n\nconst sessionId = $('Webhook').first().json.body.session_id;\nconst msisdn = $('Webhook').first().json.body.msisdn;\n\n// Path untuk menyimpan auth state\nconst authDir = '/data/wa-sessions/' + sessionId;\n\n// Buat ID unik untuk session\nconst pairingId = 'wk-' + Date.now() + '-' + Math.random().toString(36).substr(2, 9);\n\nreturn {\n  json: {\n    status: 'pairing',\n    session_id: sessionId,\n    qr: 'WALIKELAS:QR:' + pairingId + ':' + msisdn,\n    error: null,\n    auth_dir: authDir\n  }\n};"
      },
      "id": "pair-qr-action",
      "name": "Pair QR Action",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1250, 50]
    },
    {
      "parameters": {
        "jsCode": "// PAIR ACTION - Pairing Code Method (8 digit)\n// Generate 8 digit code for linking with phone number\n\nconst sessionId = $('Webhook').first().json.body.session_id;\nlet msisdn = $('Webhook').first().json.body.msisdn || '';\n\n// Normalisasi nomor: hapus semua karakter non-angka\nmsisdn = msisdn.replace(/\\D/g, '');\n\n// Validasi format Indonesia (62xx atau 08xx)\nconst validFormat = /^(62|08)\\d{8,11}$/.test(msisdn);\nif (!validFormat) {\n  return {\n    json: {\n      status: 'error',\n      session_id: sessionId,\n      pairing_code: null,\n      error: 'Format nomor salah. Gunakan format: 6281234567890 (tanpa + atau spasi)'\n    }\n  };\n}\n\n// Generate pairing code placeholder (8 karakter alphanumeric)\n// NOTE: Ini placeholder - implementasi nyata butuh Baileys\nconst chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';\nlet code = '';\nfor (let i = 0; i < 8; i++) {\n  code += chars.charAt(Math.floor(Math.random() * chars.length));\n}\n\n// Format: XXXX-XXXX untuk readability\nconst formattedCode = code.slice(0, 4) + '-' + code.slice(4);\n\nreturn {\n  json: {\n    status: 'pairing',\n    session_id: sessionId,\n    pairing_code: formattedCode,\n    msisdn_normalized: msisdn,\n    error: null,\n    expires_in: 60 // detik\n  }\n};"
      },
      "id": "pair-kode-action",
      "name": "Pair Kode Action",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1250, 250]
    },
    {
      "parameters": {
        "jsCode": "// STATUS ACTION\n// Check WhatsApp session status\n\nconst sessionId = $('Webhook').first().json.body.session_id;\n\n// Cek apakah session ada di storage\n// NOTE: Implementasi nyata butuh cek auth state Baileys\nconst sessionExists = false; // Ganti dengan cek sebenarnya\n\nif (sessionExists) {\n  return {\n    json: {\n      status: 'connected',\n      session_id: sessionId,\n      qr: null,\n      error: null\n    }\n  };\n} else {\n  return {\n    json: {\n      status: 'disconnected',\n      session_id: sessionId,\n      qr: null,\n      error: null\n    }\n  };\n}"
      },
      "id": "status-action",
      "name": "Status Action",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1000, 400]
    },
    {
      "parameters": {
        "jsCode": "// DISCONNECT ACTION\n// Terminate WhatsApp session\n\nconst sessionId = $('Webhook').first().json.body.session_id;\n\n// Hapus auth state\n// NOTE: Implementasi nyata butuh hapus folder auth Baileys\n\nreturn {\n  json: {\n    ok: true,\n    session_id: sessionId,\n    disconnected_at: new Date().toISOString()\n  }\n};"
      },
      "id": "disconnect-action",
      "name": "Disconnect Action",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1000, 600]
    },
